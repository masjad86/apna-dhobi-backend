{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Swagger": {
    "Title": "Gateway API",
    "Version": "v1"
  },
  "Jwt": {
    "SecretKey": "YourSuperSecretKeyHere",
    "Issuer": "YourIssuer",
    "Audience": "YourAudience",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://your-frontend-domain.com"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE"
    ],
    "AllowedHeaders": [
      "Content-Type",
      "Authorization",
      "Origin",
      "Accept",
      "Adhobi-Header"
    ]
  },
  "RateLimiting": {
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      }
    ]
  },
  "RateLimitPolicies": {
    "ClientPolicy": {
      "ClientWhitelist": [
        "trusted-client-1",
        "trusted-client-2"
      ]
    }
  },
  "AllowedHosts": "*"
}
